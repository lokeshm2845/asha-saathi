{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": { "includeFiles": "backend/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/app", "destination": "/web/app/index.html" },
    { "source": "/app/", "destination": "/web/app/index.html" },
    { "source": "/dashboard", "destination": "/web/dashboard/index.html" },
    { "source": "/dashboard/", "destination": "/web/dashboard/index.html" },
    { "source": "/:path((?!web/).*)", "destination": "/web/:path" }
  ]
}
